[Unit]
Description=API di lettura Palla a due
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=pallaadue
Group=pallaadue
EnvironmentFile=/etc/palla-a-due/env
WorkingDirectory=/opt/palla-a-due/app
ExecStart=/usr/bin/node api.js
Restart=on-failure
RestartSec=5
# isolamento (SQLite in WAL ha bisogno di scrivere anche per leggere: -shm)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/palla-a-due
